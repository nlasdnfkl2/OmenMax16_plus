<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Windows 전용 WinForms 프로젝트 -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>

		<!-- WebView2 어셈블리(WindowsBase) 충돌 해결을 위해 WPF 허용 추가 -->
		<UseWPF>true</UseWPF>

		<!-- 64비트 앱 -->
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
		<Prefer32Bit>false</Prefer32Bit>

		<!-- app.manifest를 실행 파일 매니페스트로 사용 -->
		<ApplicationManifest>app.manifest</ApplicationManifest>

		<!-- C# 설정 -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
		<PackageReference Include="System.Management" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
